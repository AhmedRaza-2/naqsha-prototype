{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "trailingSlash": true,
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/app/models/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/app/models/manifest.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/app/(.*).wasm", "headers": [{ "key": "Content-Type", "value": "application/wasm" }] }
  ]
}
